# Salin menjadi deploy/aapanel-profile.env di server aaPanel lalu sesuaikan.
# Tidak berisi password atau secret Laravel.

DOMAIN=sita.kampus.ac.id
APP_DIR=/www/wwwroot/sita.kampus.ac.id
PHP_BIN=/www/server/php/84/bin/php
PHP_FPM_SERVICE=php-fpm-84
PHP_FPM_RUNTIME_USER=www
PHP_FPM_RUNTIME_GROUP=www
PHP_FPM_SOCKET=/tmp/php-cgi-84.sock
NGINX_CONFIG=/www/server/panel/vhost/nginx/sita.kampus.ac.id.conf
HEALTHCHECK_URL=https://sita.kampus.ac.id/up
PUBLIC_BASE_URL=https://sita.kampus.ac.id

# Bila Cloudflare/WAF menampilkan bot verification kepada curl, Security Gate
# tetap memeriksa origin Nginx lokal menggunakan hostname dan TLS yang benar.
# Gunakan public bila server tidak berada di belakang CDN/WAF.
HTTP_PROBE_MODE=public
ORIGIN_PROBE_ADDRESS=127.0.0.1
CHECK_EDGE_HTTP=false

# Saat Release menemukan migration tertunda, tampilkan daftar dan minta Y untuk
# membuat backup otomatis lalu menerapkan migration. Nilai apply hanya untuk
# automation noninteraktif yang sudah memiliki persetujuan perubahan database.
MIGRATION_MODE=prompt
DB_BACKUP_DIR=/var/backups/sita

# Kompatibilitas perintah lama. Tetap false; gunakan MIGRATION_MODE di atas.
RUN_MIGRATIONS=false

# in-place mempertahankan pola deploy lama. atomic menyimpan candidate release,
# mengalihkan symlink current setelah build, lalu mengembalikan kode bila gate
# pascaaktivasi gagal. Migration tertunda sengaja diblokir pada mode atomic.
DEPLOYMENT_STRATEGY=in-place
RELEASE_ROOT=/www/wwwroot/sita.kampus.ac.id/.sita-release
CURRENT_LINK=/www/wwwroot/sita.kampus.ac.id/.sita-release/current
MANAGE_NGINX_ROOT=prompt
RELEASE_KEEP=3

RUN_DEPENDENCY_AUDIT=false
DEPENDENCY_AUDIT_MODE=report
DEPENDENCY_AUDIT_THRESHOLD=high
