# Salin menjadi deploy/docker-profile.env pada host Docker.
# File ini tidak berisi password, APP_KEY, atau secret Laravel.

HEALTHCHECK_URL=http://127.0.0.1:8088/up
PUBLIC_BASE_URL=http://127.0.0.1:8088
NGINX_CONFIG=docker/nginx/default.conf

# Audit dependency bersifat report secara default dan tidak mengubah lockfile.
RUN_DEPENDENCY_AUDIT=false
DEPENDENCY_AUDIT_MODE=report
DEPENDENCY_AUDIT_THRESHOLD=high
